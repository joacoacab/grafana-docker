# Grafana admin credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme_strong_password

# Domain — Traefik router rule + Let's Encrypt cert
# Local dev: localhost   |   Production: obs.siracnetwork.com
DOMAIN=obs.siracnetwork.com

# Email used for Let's Encrypt certificate notifications
TRAEFIK_ACME_EMAIL=joaco@siracnetwork.com

# Basic Auth for Loki, Prometheus and Tempo ingestion endpoints
# Generate: htpasswd -nb <user> <password>
# (use single $ signs — no sed escaping needed here)
# Example output: sirac:$apr1$xyz$hashhashhashhash
INGESTA_BASIC_AUTH=sirac:$apr1$xxxx
